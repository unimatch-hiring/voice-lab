{
  "name": "voice-lab-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:init": "node --env-file-if-exists=.env.local --input-type=module -e \"import { openDatabase } from './src/database.ts'; openDatabase().close()\"",
    "start": "node --env-file-if-exists=.env.local src/index.ts",
    "test": "node --test test/*.ts"
  }
}
